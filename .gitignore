# ─── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# ─── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ─── Nuitka build artefacts ────────────────────────────────────────────
build/dist/
*.nuitka-stamp
*.build/
*.dist/

# ─── Deployment artefacts ──────────────────────────────────────────────
deployment/
*.exe
*.AppImage
*.deb

# ─── Generated files ───────────────────────────────────────────────────
# Produced when a release is described and its manifest signed
# (BUILD_GUIDE.md, section 2.3)
release-check/
signed/
manifest.unsigned.json
wiretrace-update.json
SHA256SUMS

# ─── Keys and secrets ──────────────────────────────────────────────────
# The signing keys live offline and tools/release_keys.py refuses to
# write one inside the repository; these keep any key file out even so.
*.key
*.pem
*.p12
*.pfx
.env
.env.*

# ─── Logs and runtime data ─────────────────────────────────────────────
*.log
logs/

# ─── Testing ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ─── Type checking ─────────────────────────────────────────────────────
.mypy_cache/
.pyre/
.pytype/

# ─── IDE and editor ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sw?
*.iml
.spyderproject
.spyproject
*~

# ─── Operating system ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ─── Secrets ───────────────────────────────────────────────────────────
# Never commit credentials, signing certs, or private keys
*.pfx
*.p12
*.key
*.pem
.env
.env.local
secrets.json

# ─── Temporary files ───────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
.cache/
